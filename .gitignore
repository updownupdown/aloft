# Godot 4+ specific ignores
.godot/
.import/
export.cfg
export_credentials.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores (unused, GDScript-only project, kept for safety)
.mono/
data_*/

# Build/export output
export/**
!export/.gitkeep

# Android build artifacts (generated by Godot's Android export)
android/build/
android/.gradle/

# OS / editor cruft
.DS_Store
Thumbs.db
*.tmp

# Python cache (art pipeline scripts)
__pycache__/
*.pyc
